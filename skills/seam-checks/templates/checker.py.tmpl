#!/usr/bin/env python3
"""Assert this repo's docs still agree with each other and with the code.

Generated by seam {{SEAM_VERSION}}. **Do not edit this file.** Every repo-specific knob lives in
`{{CONFIG_PATH}}` and is read at run time, so regenerating is always safe — and a knob edited
into this script is a knob the next regeneration silently drops. To add an assertion this repo
needs and seam does not have, put it in `.seam/assertions/*.py`; those are discovered here and
never overwritten.

Stdlib only, no network, deterministic. Run it:

    python3 {{CHECKER_PATH}}                  # check
    python3 {{CHECKER_PATH}} --write-baseline # record today's violations as the baseline

Exit 0: no violations outside the baseline. Exit 1: violations, listed on stderr.
"""
from __future__ import annotations

import errno
import fnmatch
import importlib.util
import json
import os
import re
import subprocess
import sys
from pathlib import Path

SEAM_VERSION = "{{SEAM_VERSION}}"
CONFIG_PATH = "{{CONFIG_PATH}}"

ROOT = Path(__file__).resolve().parent
while not (ROOT / CONFIG_PATH).exists() and ROOT != ROOT.parent:
    ROOT = ROOT.parent

LAYER_NAMES = {1: "Artifact", 2: "Current", 3: "Decisions", 4: "Intent", 5: "Seam", 6: "Ledger"}

MARK_START = "<!-- seam:sources-of-truth start -->"
MARK_END = "<!-- seam:sources-of-truth end -->"

# `~~struck~~` is where a FORMER truth legitimately lives: the convention that lets a reader see
# why a line changed. Blanked for the assertions about vocabulary, keeping offsets so the line
# numbers stay true. Bounded to a span that does not cross a blank line, because an unbalanced
# `~~` would otherwise pair with the next one paragraphs away and silently swallow the text
# between — a check that stops checking rather than one that fails.
STRUCK_RE = re.compile(r"~~(?:[^~\n]|\n(?!\n))*?~~")


def blank(m: re.Match) -> str:
    return re.sub(r"[^\n]", " ", m.group(0))


def without_struck(text: str) -> str:
    return STRUCK_RE.sub(blank, text)


def line_of(text: str, index: int) -> int:
    return text.count("\n", 0, index) + 1


def glob_re(pattern: str) -> re.Pattern:
    """A path glob as a regex. `**/` crosses directories, `*` and `?` do not."""
    out = []
    i = 0
    while i < len(pattern):
        if pattern.startswith("**/", i):
            out.append("(?:.*/)?")
            i += 3
        elif pattern[i] == "*":
            out.append("[^/]*")
            i += 1
        elif pattern[i] == "?":
            out.append("[^/]")
            i += 1
        else:
            out.append(re.escape(pattern[i]))
            i += 1
    return re.compile("^" + "".join(out) + "$")


SKIP = {".git", "node_modules", "dist", "build", ".next", "vendor", "__pycache__",
        ".venv", "venv", "target", ".turbo", "coverage"}


def all_files(root: Path) -> list[str]:
    """Every file in the repo, skipping nested checkouts and build output.

    A directory holding a `.git` entry is another repo's tree — a worktree or a vendored clone —
    and is not walked. Without that, one real repo's seven worktrees contributed sixty-seven
    files that are not this repo's.
    """
    out = []
    for dirpath, dirnames, filenames in os.walk(root):
        rel_dir = os.path.relpath(dirpath, root)
        if rel_dir != "." and ".git" in dirnames + filenames:
            dirnames[:] = []
            continue
        dirnames[:] = sorted(d for d in dirnames if d not in SKIP)
        for f in sorted(filenames):
            rel = f if rel_dir == "." else os.path.join(rel_dir, f)
            out.append(rel.replace(os.sep, "/"))
    return out


def glob_files(root: Path, pattern: str) -> list[str]:
    """Files matching a path glob, from the same walk the rest of the checker uses.

    Not `Path.glob`: that would reach into a nested checkout, and the Node emission has no
    equivalent — the two have to agree on the file set or they cannot agree on a count.
    """
    rx = glob_re(pattern)
    return sorted(f for f in all_files(root) if rx.match(f))


def walk_md(root: Path) -> list[str]:
    """Every markdown file under docs/ plus every one at the repo root."""
    return sorted(f for f in all_files(root)
                  if f.endswith(".md") and (f.startswith("docs/") or "/" not in f))


# ── Markdown reading ─────────────────────────────────────────────────────────

def headings(text: str) -> list[str]:
    out = []
    for m in re.finditer(r"^#{1,6}[ \t]+(.*)$", text, re.M):
        h = m.group(1).replace("~~", "").replace("**", "").replace("*", "").replace("`", "").strip()
        if h:
            out.append(h)
    return out


def anchors(text: str) -> set[str]:
    """Every name a section of this file can legitimately be cited by.

    The full heading, every dash-separated clause of it, and every leading word-sequence of each
    clause — because people cite `§ Contact` when the heading is "Contact and identification",
    and `§ Geometry` when it is "D-012 — Geometry and spacing". Measured: without this, one real
    repo reported 934 dangling section citations, nearly all of them those two shapes. A baseline
    of 934 is not a ratchet.
    """
    out: set[str] = set()
    for h in headings(text):
        out.add(h.lower())
        # Split on a comma as well as an em dash: "API, and what it refuses" is cited as
        # § API, and an em-dash-only split missed that shape repeatedly on a real repo.
        #
        # Only the FIRST clause gets leading-word expansion. Expanding the tail clauses too fed
        # one-word anchors like `and` and `a` into the set — from headings written "Checks, and
        # what each one does" or "Pipeline, a note on scoring" — and since a citation matches any
        # anchor it starts with on a word boundary, A2 then silently passed citations to sections
        # that do not exist. A check that stops checking is worse than one that fails.
        clauses = [c.strip() for c in re.split(r" — |, ", h) if c.strip()]
        for i, c in enumerate(clauses):
            out.add(c.lower())
            if i:
                continue
            words = [w for w in c.lower().split() if w]
            for k in range(1, len(words) + 1):
                out.add(" ".join(words[:k]))
    return out


def cites_section(anchor_set: set[str], cited: str) -> bool:
    """A citation carries the prose that follows it, so a match is the longest anchor it starts
    with, ending on a word boundary: "Seams" does not satisfy "Seam 9"."""
    low = " ".join(cited.split()).lower().rstrip(")")
    for a in sorted(anchor_set, key=len, reverse=True):
        if low.startswith(a) and (len(low) == len(a) or not low[len(a)].isalnum()):
            return True
    return False


def section_body(text: str, name: str) -> str | None:
    """The lines under the heading called `name`, to the next heading at the same level or above.

    `None` when there is no such heading — which callers report rather than treat as empty. A
    renamed heading that silently compared nothing is the exact failure this returns None for.
    """
    lines = text.split("\n")
    start = None
    start_level = 0
    low = name.lower()
    for i, line in enumerate(lines):
        # Levels 2 to 6: a `#` heading is the document's title, not a section of it. Without that
        # bound, `§ Checks` in a file called "# Checks" matched the title, whose body is the
        # whole file — so a renamed section still compared something and passed.
        m = re.match(r"^(#{2,6})[ \t]+(.*)$", line)
        if not m:
            continue
        clean = m.group(2).replace("~~", "").replace("**", "").replace("*", "").strip().lower()
        if start is None:
            # The same rule citations use: the heading begins with the cited name, ending on a
            # word boundary — "The issues" names "The issues, in the order they can be built".
            if clean.startswith(low) and (len(clean) == len(low) or not clean[len(low)].isalnum()):
                start, start_level = i + 1, len(m.group(1))
            continue
        if len(m.group(1)) <= start_level:
            return "\n".join(lines[start:i])
    return None if start is None else "\n".join(lines[start:])


ASCII_WS = " \t\r\n\f\v"


def table_cells(line: str) -> list[str] | None:
    """The cells of a markdown table row, or None when the line is not one. A8 and A14 read their
    tables through this and nothing else.

    At most one pipe is dropped at each end, and only ASCII whitespace is trimmed. Both are on
    purpose: the other checker has to read the same row the same way, and each language's own
    strip has a different idea of both — Python's `strip("|")` takes every pipe, and `trim()` and
    `strip()` disagree about U+FEFF and U+0085.
    """
    t = line.strip(ASCII_WS)
    if not t.startswith("|"):
        return None
    t = t[1:]
    if t.endswith("|"):
        t = t[:-1]
    return [c.strip(ASCII_WS) for c in t.split("|")]


# ── The assertion pattern ────────────────────────────────────────────────────

DEFAULT_ASSERTION_PATTERN = r"{{DEFAULT_ASSERTION_PATTERN}}"

# What a backslash may be followed by: a class or control escape, or any non-alphanumeric
# printable ASCII character, which both engines read as that character. A letter or a digit is
# refused — `\B` matches an empty string in Node and nowhere in one in Python, and `\q` is an
# error in Python and a literal in Node. `\b` is an anchor and is handled where it can appear.
ESCAPE_LETTERS = "wWdDsSnrt"
ESCAPE_PUNCT_RE = re.compile(r"[\x20-\x2f\x3a-\x40\x5b-\x60\x7b-\x7e]")


def escapable(d: str) -> bool:
    return d != "" and (d in ESCAPE_LETTERS or ESCAPE_PUNCT_RE.fullmatch(d) is not None)


def portable_regex(p: str) -> str | None:
    """Why `p` is not a pattern both emitted checkers read the same way, or None when it is.

    `assertions.A14.assertion_pattern` is run by a Python engine here and a Node one in the other
    checker, and they disagree about plenty: inline flags, named groups, a range out of a class
    escape, possessive quantifiers, `{,n}`. A checker that ran whatever its own engine accepted
    would pass a repo in one language and fail it in the other, so a pattern is held to a subset
    both read identically — literals, `.`, `^` `$` `|`, `(…)` and `(?:…)`, simple `[…]` classes,
    the escapes above, `\b`, and `* + ? {n} {n,} {n,m}` with an optional lazy `?`. Printable
    ASCII only. It is a scanner and not a regex because a regex cannot count brackets.
    """
    if p == "":
        return "it is empty"

    def bad(k: int) -> str:
        return f"character {k + 1} is outside the subset both checkers read the same way"

    odd = re.search(r"[^\x20-\x7e]", p)
    if odd:
        return bad(odd.start())
    n = len(p)
    i = 0
    depth = 0
    prev = None                     # what a quantifier may follow: "atom", or nothing
    while i < n:
        c = p[i]
        if c == "\\":
            d = p[i + 1:i + 2]
            if d == "b":
                prev = "anchor"
            elif escapable(d):
                prev = "atom"
            else:
                return bad(i)
            i += 2
        elif c == "[":
            j = i + 1
            if p[j:j + 1] == "^":
                j += 1
            items = 0
            while True:
                k = p[j:j + 1]
                if k == "":
                    return bad(i)                                 # never closed
                if k == "]":
                    if items == 0:
                        return bad(j)                             # empty: engines disagree
                    j += 1
                    break
                if k == "\\":
                    d = p[j + 1:j + 2]
                    if not escapable(d):
                        return bad(j)
                    j += 2
                elif k in ("[", "&", "~", "|"):
                    return bad(j)                                 # Python warns these may change
                elif k == "-":
                    # A hyphen is a literal only at either end of the class; anywhere else it is
                    # a range operator, and what a range from a class escape means differs by
                    # engine.
                    if items != 0 and p[j + 1:j + 2] != "]":
                        return bad(j)
                    j += 1
                elif p[j + 1:j + 2] == "-" and p[j + 2:j + 3] not in ("]", ""):
                    hi = p[j + 2:j + 3]
                    if hi in "\\[]-&~|" or hi < k:
                        return bad(j)
                    j += 3
                else:
                    j += 1
                items += 1
            prev = "atom"
            i = j
        elif c == "(":
            if p[i + 1:i + 2] == "?":
                if p[i + 2:i + 3] != ":":
                    return bad(i)                                 # lookaround, flags, names
                i += 3
            else:
                i += 1
            depth += 1
            prev = None
        elif c == ")":
            if depth == 0:
                return bad(i)
            depth -= 1
            prev = "atom"
            i += 1
        elif c == "|":
            prev = None
            i += 1
        elif c in ("^", "$"):
            prev = "anchor"
            i += 1
        elif c in ("*", "+", "?"):
            if prev != "atom":
                return bad(i)
            i += 1
            if p[i:i + 1] == "?":                                 # lazy; a second quantifier is refused
                i += 1
            prev = "quantified"
        elif c == "{":
            m = re.match(r"\{(\d{1,3})(?:,(\d{0,3}))?\}", p[i:], re.A) if prev == "atom" else None
            if not m or (m.group(2) and int(m.group(2)) < int(m.group(1))):
                return bad(i)
            i += len(m.group(0))
            if p[i:i + 1] == "?":
                i += 1
            prev = "quantified"
        elif c in ("}", "]"):
            return bad(i)
        else:
            prev = "atom"                                         # `.` and every plain literal
            i += 1
    return None if depth == 0 else "a group is never closed"


MD_CITE_RE = re.compile(r"`([\w./@-]+\.md)`")
# A `|` ends a section name: it is a table cell boundary and never part of a heading.
TOKEN_RE = re.compile(r"`([^`\n]+)`|(?<![`\w./-])([\w./-]+\.md)(?![\w.-])"
                      r"|§[ \t\n]*([A-Za-z][^.;:—(*`§|\n]*)")
ADJACENT_RE = re.compile(r"^[\s,*]{0,4}$")
CONNECTOR_RE = re.compile(r"^[\s,]*(?:and|or)?[\s,]*$")


def resolve_md(root: Path, frm: str, cited: str) -> str | None:
    if (root / cited).exists():
        return cited
    beside = os.path.normpath(os.path.join(os.path.dirname(frm), cited)).replace(os.sep, "/")
    return beside if (root / beside).exists() else None


# What A12 freezes: a RECORD, not the file that indexes it. An index grows by design — adding a
# version means appending a row — and a "current" file is replaced wholesale when a new version
# lands. Freezing either makes the layer unusable, which is the opposite of enforcing its edit
# rule. A template is a form, not a record, so it is not frozen either.
NOT_A_RECORD = {"README.md", "template.md", "PRD-current.md", "index.md"}


def frozen_record(path: str) -> bool:
    return os.path.basename(path) not in NOT_A_RECORD


def md_citations(root: Path, frm: str, text: str) -> list[tuple[str, int]]:
    """Every `*.md` path this file claims exists, with its offset.

    A backticked path that is the TEXT of a markdown link is a label, not a citation: in
    ``[`api.md`](.claude/rules/api.md)`` the link target is the claim and the label is how it
    reads. Measured on a repo nothing was tuned against — a README listing eight rules that way
    reported eight dangling citations, every one of them wrong, while the targets all resolved.
    So a label whose link target is a markdown path yields the TARGET, and the label is dropped.
    """
    out: list[tuple[str, int]] = []
    linked_spans: list[tuple[int, int]] = []
    for m in re.finditer(r"\[([^\]\n]*)\]\(([^)\s]+)\)", text):
        linked_spans.append((m.start(1), m.end(1)))
        target = m.group(2).split("#")[0]
        if target.endswith(".md"):
            out.append((target, m.start()))
    for m in MD_CITE_RE.finditer(text):
        if any(s <= m.start(1) and m.end(1) <= e for s, e in linked_spans):
            continue
        out.append((m.group(1), m.start()))
    return out


# ── The sources-of-truth table ───────────────────────────────────────────────

def read_table(text: str) -> list[dict]:
    """Rows of the table, as `{doc, layer, owns, enforces, line}`.

    Scoped to the marked span when the markers are there, so a table elsewhere in the file is not
    read as this one.
    """
    start = text.find(MARK_START)
    end = text.find(MARK_END)
    body = text[start:end] if (start != -1 and end > start) else text
    offset = start if (start != -1 and end > start) else 0
    rows = []
    for m in re.finditer(r"^\|(.*)\|[ \t]*$", body, re.M):
        cells = [c.strip() for c in m.group(1).split("|")]
        doc = re.fullmatch(r"`([^`]+)`", cells[0]) if cells else None
        if not doc:
            continue
        layer = None
        if len(cells) > 1:
            lm = re.match(r"(\d)\b", cells[1])
            if lm:
                layer = int(lm.group(1))
        rows.append({
            "doc": doc.group(1),
            "layer": layer,
            "owns": cells[2] if len(cells) > 2 else "",
            "enforces": (cells[3].strip("`") if len(cells) > 3 else ""),
            "line": line_of(text, offset + m.start()),
        })
    return rows


# ── Artifact parsing ─────────────────────────────────────────────────────────

def sql_tables(sql: str) -> dict[str, set[str]]:
    out = {}
    for m in re.finditer(r"create table (?:if not exists )?(\w+)\s*\((.*?)\n\);", sql, re.S | re.I):
        cols = set(re.findall(r"^\s{2,}(\w+)\s", m.group(2), re.M))
        out[m.group(1)] = cols
    return out


def sql_enum(sql: str, name: str) -> set[str] | None:
    m = re.search(r"create type\s+" + re.escape(name) + r"\s+as enum\s*\((.*?)\);", sql, re.S | re.I)
    return set(re.findall(r"'([^']+)'", m.group(1))) if m else None


def ts_unions(text: str) -> dict[str, set[str]]:
    out = {}
    for m in re.finditer(r"(?:type|enum)\s+(\w+)\s*=?\s*\{?([^;}]*)[;}]", text):
        members = set(re.findall(r"['\"]([\w-]+)['\"]", m.group(2)))
        if members:
            out[m.group(1)] = members
    return out


# ── A3: the documented check list against CI ─────────────────────────────────

# Right-hand sides that are not fields: file extensions and hostname endings. A dotted name
# whose right half is one of these is a path or a host, not a reference.
# Deliberately narrow: only endings that cannot plausibly be a column or a union member.
# `html`, `json`, `log`, `env`, `css`, `txt`, `csv`, `xml`, `svg`, `pdf`, `app` and `dev` were all
# in an earlier version of this list and are all plausible field names — a repo documenting
# `pages.html` would have had A4 stay green forever through a rename. Set
# `assertions.A4.not_fields_override` to replace this list outright.
DEFAULT_NOT_FIELDS = {
    "md", "sql", "yml", "yaml", "toml", "ini", "cfg", "tmpl",
    "py", "pyi", "mjs", "cjs", "jsx", "tsx", "sh", "bash", "zsh", "rb", "rs", "kt", "swift",
    "php", "prisma", "proto", "graphql", "lock", "webp", "ico", "gz", "tgz", "whl",
    "com", "org", "net", "gov", "edu", "il", "uk", "online",
}

DEFAULT_TOKEN_RES = [
    r"scripts/[\w.\-/]+\.(?:py|sql|mjs|js|ts|sh)",
    r"(?:npm|pnpm|yarn|bun) run [\w:.\-]+",
    r"node --test",
    r"(?:^|&&|;|\|)\s*(?:pytest|ruff|mypy|eslint|tsc|cargo|go test)\b",
    r"check:[a-z\-]+",
    r"docker build",
    r"drop schema public cascade",
]
TURBO_RE = re.compile(r"turbo run ((?:[a-z]+ )*[a-z]+)")


def strip_comments(text: str) -> str:
    """Drop shell and YAML comments, keeping a quoted `#` as the content it is.

    A path named in a trailing comment used to satisfy its own token and mask the removal of the
    command that actually invokes it, so comments go. A `#` inside quotes is content —
    `echo "closes #12" && pytest` kept only `echo "closes ` under a plain regex, and the check
    then reported pytest as documented-but-not-in-CI: a red naming a real check for a cause that
    is not real. Quote state resets at each newline, which is a known hole on a quote opened in
    one line of a block scalar and closed in the next, and is accepted: carrying state across
    newlines would let one apostrophe in a prose comment poison every line after it.
    """
    text = re.sub(r"\\\n", " ", text)
    out = []
    for line in text.split("\n"):
        quote = ""
        cut = None
        for i, ch in enumerate(line):
            if quote:
                if ch == quote:
                    quote = ""
            elif ch in "'\"":
                quote = ch
            elif ch == "#" and (i == 0 or line[i - 1].isspace()):
                cut = i
                break
        out.append(line if cut is None else line[:cut])
    return "\n".join(out)


def check_tokens(text: str, extra: list[str]) -> set[str]:
    """What checks a block of shell performs, ignoring how each was invoked."""
    text = strip_comments(text)
    found = set()
    for rx in DEFAULT_TOKEN_RES + list(extra):
        for m in re.finditer(rx, text, re.M):
            found.add(m.group(0).lstrip("&|; \n\t"))
    for m in TURBO_RE.finditer(text):
        for task in m.group(1).split():
            found.add("turbo:" + task)
    return found


RUN_KEY_RE = re.compile(r"^[ \t]*(?:-[ \t]+)?(run:)[ \t]*(\|[-+0-9]*)?[ \t]*(.*)$")


def run_payloads(yaml_text: str) -> list[tuple[int, str]]:
    """Every `run:` payload in a workflow, with the line it starts on.

    An indentation-aware scan rather than a regex: YAML already says where a payload ends, since
    every line of it is indented deeper than its key. A regex that stopped at the next line
    beginning with a dash or a key ate a backslash continuation, which took a real CI-only check
    out of the comparison entirely. Only `run:` is read — a `uses:` step is setup, not a check.
    """
    lines = yaml_text.split("\n")
    out = []
    i = 0
    while i < len(lines):
        m = RUN_KEY_RE.match(lines[i])
        if not m:
            i += 1
            continue
        col = m.start(1)
        body = [m.group(3)]
        start = i + 1
        j = i + 1
        while j < len(lines):
            line = lines[j]
            if line.strip() == "":
                body.append("")
                j += 1
                continue
            indent = len(line) - len(line.lstrip())
            if indent <= col:
                break
            body.append(line)
            j += 1
        out.append((start, "\n".join(body)))
        i = j
    return out


# ── Findings ─────────────────────────────────────────────────────────────────

def finding(fid: str, file: str, line: int, text: str, message: str) -> dict:
    return {"id": fid, "file": file, "line": line, "text": text, "message": message}


def main() -> int:
    cfg_file = ROOT / CONFIG_PATH
    if not cfg_file.exists():
        print(f"seam: no {CONFIG_PATH} found above {Path(__file__).resolve().parent}",
              file=sys.stderr)
        return 2
    cfg = json.loads(cfg_file.read_text())
    A = cfg.get("assertions", {})
    on = lambda k: bool(A.get(k, {}).get("enabled"))
    opt = lambda k, name, default=None: A.get(k, {}).get(name, default)

    # A checker that measures nothing cannot be told from one that passed, which is the thing
    # this whole layer exists to prevent. Refuse rather than exit 0.
    enabled = [k for k in A if A[k].get("enabled")]
    if not enabled and not (ROOT / ".seam" / "assertions").is_dir():
        print(f"seam: no assertions are enabled in {CONFIG_PATH}, and there are none in "
              f".seam/assertions/ — this checker would measure nothing and exit 0, which cannot "
              f"be told apart from passing. Enable at least one.", file=sys.stderr)
        return 2

    # An allow-list entry means "this will never be fixed", so the method requires a written
    # reason. Nothing read the field, which made the requirement a sentence.
    for aid, conf in sorted(A.items()):
        for i, e in enumerate(conf.get("allow", []) or []):
            if not str(e.get("reason", "")).strip():
                print(f"seam: {CONFIG_PATH} assertions.{aid}.allow[{i}] exempts "
                      f"{e.get('path', '<no path>')!r} with no reason. An allow-list entry means "
                      f"\"this will never be fixed\" — write why, or use the baseline, which "
                      f"means \"not yet\".", file=sys.stderr)
                return 2

    host = cfg["table"]["file"]
    docs = walk_md(ROOT)
    text_of = {d: (ROOT / d).read_text() for d in docs if (ROOT / d).exists()}
    anchors_of = {d: anchors(t) for d, t in text_of.items()}
    table = read_table(text_of.get(host, ""))
    findings: list[dict] = []
    ran = 0

    # ── A1. Every `*.md` path cited in backticks resolves. ───────────────────
    #
    # Markdown only, on purpose: a citation a reader cannot open is a defect, and widening this
    # to every backticked path turns every shell fragment into a claim about the filesystem.
    # A glob is not a citation of a file and is skipped.
    if on("A1"):
        ran += 1
        allowed = {e["path"] for e in opt("A1", "allow", [])}
        # A doc that describes work NOT YET DONE cites files as intentions, not as claims about
        # the tree: an implementation plan names what it is about to create. Those citations are
        # neither debt (a baseline means "not yet" and they evaporate on landing) nor approvals
        # (an allow-list means "never"), so the doc is what is exempted rather than each path.
        intent = [glob_re(g) for g in opt("A1", "intent_globs", [])]
        for d in docs:
            if any(rx.match(d) for rx in intent):
                continue
            for cited, at in md_citations(ROOT, d, text_of[d]):
                if "*" in cited or cited in allowed:
                    continue
                if resolve_md(ROOT, d, cited) is None:
                    findings.append(finding(
                        "A1", d, line_of(text_of[d], at), cited,
                        f"cites `{cited}`, which is not in the repo — fix or drop the citation, "
                        f"or add it to assertions.A1.allow with a reason"))

    # ── A2. Every `§ Section` citation names a heading that exists. ──────────
    #
    # Only the TARGETED form by default: `` `x.md` § Name ``, and a following run of `§`s
    # separated by nothing but a connector, which is how these are written. A bare `§` whose
    # subject was named in an earlier sentence falls back to the file it is written in, and that
    # is a guess — measured on a 45-doc repo, the targeted form gave 19 misses and the fallback
    # 205, nearly all of them a § whose real subject was a skill or another file. Switch
    # `assertions.A2.bare_sections` on to check it anyway.
    if on("A2"):
        ran += 1
        bare_too = bool(opt("A2", "bare_sections", False))
        for d in docs:
            text = text_of[d]
            base = 0
            for para in re.split(r"\n[ \t]*\n", text):
                target = None
                target_end = -1
                shadow = None
                shadow_end = -1
                for m in TOKEN_RE.finditer(para):
                    backticked, bare, name = m.group(1), m.group(2), m.group(3)
                    if backticked is not None or bare is not None:
                        tok = (backticked if backticked is not None else bare).strip()
                        if re.fullmatch(r"[\w./@-]+\.md", tok) and "*" not in tok:
                            target = resolve_md(ROOT, d, tok) or tok
                            target_end = m.end()
                            shadow = None
                        elif backticked is not None and re.fullmatch(r"[\w./@-]+", tok):
                            # `some-skill` § The one gate names something that is not a file.
                            # Unresolvable is not a defect; a check that reds on a citation it
                            # cannot evaluate is a check that gets switched off.
                            shadow, shadow_end = tok, m.end()
                        else:
                            shadow = None
                        continue
                    cited = name.strip()
                    if shadow is not None and m.start() - shadow_end <= 4 \
                            and ADJACENT_RE.match(para[shadow_end:m.start()]):
                        shadow = None
                        continue
                    targeted = False
                    file = d
                    if target is not None:
                        gap = para[target_end:m.start()]
                        if ADJACENT_RE.match(gap) or CONNECTOR_RE.match(gap):
                            file, targeted = target, True
                            target_end = m.end()
                        else:
                            target = None
                    if not targeted and not bare_too:
                        continue
                    aset = anchors_of.get(file)
                    if aset is None:
                        if not (ROOT / file).exists():
                            continue       # A1 owns a path that does not resolve
                        aset = anchors((ROOT / file).read_text())
                        anchors_of[file] = aset
                    if not cites_section(aset, cited):
                        findings.append(finding(
                            "A2", d, base + line_of(para, m.start()), f"{file} § {cited}",
                            f"cites `{file}` § {cited}, which names no heading there"))
                base += para.count("\n") + 2

    # ── A3. The documented check list and CI name the same commands. ─────────
    #
    # Both sides are section-scoped, or an illustrative fenced block in prose becomes a command
    # CI is held to. A configured section that is missing FAILS, saying the comparison was not
    # made — distinct from a missing check, and never a silent skip, because a renamed heading
    # would otherwise take half the list quietly out of scope.
    if on("A3"):
        ran += 1
        local_only = set(opt("A3", "local_only", []))
        ci_only = set(opt("A3", "ci_only", []))
        extra = opt("A3", "extra_tokens", [])
        documented: dict[str, tuple[str, int]] = {}
        scoped = True
        for site in opt("A3", "doc_sections", []):
            f, name = site["file"], site["section"]
            if f not in text_of:
                findings.append(finding("A3", f, 1, name,
                    f"assertions.A3 names `{f}`, which is not a doc here — the comparison "
                    f"against CI was not made"))
                scoped = False
                continue
            body = section_body(text_of[f], name)
            if body is None:
                findings.append(finding("A3", f, 1, name,
                    f"no section called § {name} in `{f}` — the comparison against CI was "
                    f"not made, which a renamed heading would otherwise do silently"))
                scoped = False
                continue
            blocks = re.findall(r"```bash\n(.*?)```", body, re.S)
            if not blocks:
                findings.append(finding("A3", f, 1, name,
                    f"§ {name} in `{f}` has no ```bash block — the comparison against CI "
                    f"was not made"))
                scoped = False
                continue
            joined = "\n".join(blocks)
            for lit in local_only:
                joined = joined.replace(lit, "")
            at = text_of[f].find(name)
            for tok in check_tokens(joined, extra):
                documented.setdefault(tok, (f, line_of(text_of[f], at if at >= 0 else 0)))
        if scoped:
            glob = opt("A3", "workflow_glob", ".github/workflows/*.yml")
            workflows = glob_files(ROOT, glob)
            if not workflows:
                findings.append(finding("A3", glob, 1, "",
                    "no workflow matches assertions.A3.workflow_glob — the comparison was not "
                    "made. Switch A3 off until CI exists; off is distinct from passing"))
            else:
                in_ci: dict[str, tuple[str, int]] = {}
                for rel in workflows:
                    for line_no, payload in run_payloads((ROOT / rel).read_text()):
                        for tok in check_tokens(payload, extra):
                            in_ci.setdefault(tok, (rel, line_no))
                for tok, (f, ln) in sorted(documented.items()):
                    if tok not in in_ci and tok not in ci_only:
                        findings.append(finding("A3", f, ln, tok,
                            f"`{tok}` is documented as a check but no CI step runs it"))
                for tok, (f, ln) in sorted(in_ci.items()):
                    if tok not in documented and tok not in local_only:
                        findings.append(finding("A3", f, ln, tok,
                            f"CI runs `{tok}` but no documented check list names it"))

    # ── A4. Every `<identifier>.<field>` in prose resolves. ──────────────────
    if on("A4"):
        ran += 1
        # A built-in default, because an empty list is not a sensible one: on a real repo it read
        # `jobs.py` and `apiaries.io` as table columns. `not_fields` ADDS to the default, so a
        # repo cannot lose it by naming one exemption of its own; `not_fields_override` replaces
        # it outright, for the repo whose column really is called `html`.
        override = opt("A4", "not_fields_override", None)
        not_fields = (set(override) if override is not None
                      else DEFAULT_NOT_FIELDS | set(opt("A4", "not_fields", [])))
        not_refs = set(opt("A4", "not_references", []))
        # Own keys only, matched to the Node emission's Object.hasOwn: a prototype member name on
        # the left of a dotted reference used to crash that side and pass silently here.
        tables: dict[str, set[str]] = {}
        for art in opt("A4", "artifacts", []):
            p = ROOT / art["path"]
            if not p.exists():
                findings.append(finding("A4", art["path"], 1, "",
                    "assertions.A4 names this artifact, which is not in the repo — nothing was "
                    "resolved against it"))
                continue
            if art.get("parser") == "sql":
                tables.update(sql_tables(p.read_text()))
            elif art.get("parser") == "ts":
                tables.update({k: v for k, v in ts_unions(p.read_text()).items()})
        if tables:
            for d in docs:
                for m in re.finditer(r"`(\w+)\.(\w+)`", text_of[d]):
                    whole, left, right = m.group(0).strip("`"), m.group(1), m.group(2)
                    if right in not_fields or whole in not_refs or left not in tables:
                        continue
                    if right not in tables[left]:
                        findings.append(finding(
                            "A4", d, line_of(text_of[d], m.start()), whole,
                            f"`{whole}` does not resolve: `{left}` has no `{right}`. The "
                            f"artifact is authoritative"))

    # ── A5. A vocabulary block names exactly the members the artifact defines. ──
    if on("A5"):
        ran += 1
        for v in opt("A5", "vocabularies", []):
            f, name = v["file"], v["section"]
            if f not in text_of:
                findings.append(finding("A5", f, 1, name,
                    f"assertions.A5 names `{f}`, which is not a doc here"))
                continue
            body = section_body(without_struck(text_of[f]), name)
            if body is None:
                findings.append(finding("A5", f, 1, name,
                    f"no section called § {name} in `{f}` — the vocabulary was not compared"))
                continue
            blocks = re.findall(r"```[\w]*\n(.*?)```", body, re.S)
            if not blocks:
                findings.append(finding("A5", f, 1, name,
                    f"§ {name} in `{f}` has no fenced block — the vocabulary was not compared"))
                continue
            stated = {w.strip() for w in re.split(r"[\s,]+", "\n".join(blocks)) if w.strip()}
            defined = None
            for art in opt("A4", "artifacts", []) or cfg.get("artifacts", []):
                p = ROOT / art["path"]
                if not p.exists():
                    continue
                if art.get("parser") == "sql":
                    defined = sql_enum(p.read_text(), v["enum"])
                elif art.get("parser") == "ts":
                    defined = ts_unions(p.read_text()).get(v["enum"])
                if defined is not None:
                    break
            at = line_of(text_of[f], max(text_of[f].find(name), 0))
            if defined is None:
                findings.append(finding("A5", f, at, v["enum"],
                    f"the artifact defines no vocabulary called `{v['enum']}`"))
                continue
            for extra_member in sorted(stated - defined):
                findings.append(finding("A5", f, at, extra_member,
                    f"§ {name} lists `{extra_member}`, which the artifact does not define"))
            for missing in sorted(defined - stated):
                findings.append(finding("A5", f, at, missing,
                    f"the artifact defines `{missing}`, which § {name} does not list"))

    # ── A6. A retired name never reappears. ─────────────────────────────────
    if on("A6"):
        ran += 1
        for entry in opt("A6", "retired", []):
            rx = re.compile(r"\b" + re.escape(entry["name"]) + r"\b", re.I)
            for d in docs:
                for m in rx.finditer(without_struck(text_of[d])):
                    findings.append(finding(
                        "A6", d, line_of(text_of[d], m.start()), entry["name"],
                        f"`{entry['name']}` is retired — it became `{entry.get('became', '?')}`"
                        f" ({entry.get('reason', 'no reason recorded')})"))

    # ── A7. A reversed decision is not prescribed again. ────────────────────
    #
    # The prescriptive form only. A doc may *discuss* a reversed decision — a revision note has
    # to be able to say what was reversed — so the pattern in the config is written to match
    # the prescription and not the discussion.
    if on("A7"):
        ran += 1
        for entry in opt("A7", "reversed", []):
            rx = re.compile(entry["pattern"])
            for d in docs:
                for m in rx.finditer(without_struck(text_of[d])):
                    where = entry.get("adr", "the decision record")
                    findings.append(finding(
                        "A7", d, line_of(text_of[d], m.start()), m.group(0),
                        f"prescribes a reversed decision: {entry['reason']} — see `{where}`"))

    # ── A8. One issue, one owning plan. ─────────────────────────────────────
    if on("A8"):
        ran += 1
        globs = opt("A8", "plan_glob", "docs/plans/*.md")
        globs = [globs] if isinstance(globs, str) else list(globs)
        res = [glob_re(g) for g in globs]
        # Enabled and matching nothing is not a pass. Same rule A3 and A12 follow: an assertion
        # that cannot make its comparison says so, because silence reads as evidence.
        plans = [d for d in docs if any(rx.match(d) for rx in res)]
        if not plans:
            findings.append(finding("A8", CONFIG_PATH, 1, ", ".join(globs),
                f"assertions.A8 is enabled and `{', '.join(globs)}` matches no doc — the "
                f"one-issue-one-plan comparison was not made. Point it at the layer-5 rows, or "
                f"switch A8 off; off is distinct from passing"))
        owners: dict[str, list[tuple[str, int]]] = {}
        for d in plans:
            body = section_body(text_of[d], "The issues")
            if body is None:
                continue
            base = text_of[d].split("\n").index(body.split("\n")[0]) + 1 if body.strip() else 0
            for i, line in enumerate(body.split("\n")):
                cells = table_cells(line)
                if cells is None:
                    continue
                if len(cells) < 2 or not re.fullmatch(r"~*\d+~*", cells[0]):
                    continue
                m = re.search(r"#(\d+)", cells[1])
                if m:
                    owners.setdefault(m.group(1), []).append((d, base + i))
        for issue, places in sorted(owners.items(), key=lambda kv: int(kv[0])):
            if len({p[0] for p in places}) > 1:
                where = ", ".join(sorted({p[0] for p in places}))
                for f, ln in sorted(places):
                    findings.append(finding("A8", f, ln, "#" + issue,
                        f"#{issue} is owned by more than one plan ({where}) — one issue, one "
                        f"owning plan, so \"where is this tracked\" has one answer"))

    # ── A9. A stated count matches a computed one. ──────────────────────────
    WORDS = {"one": 1, "two": 2, "three": 3, "four": 4, "five": 5, "six": 6, "seven": 7,
             "eight": 8, "nine": 9, "ten": 10, "eleven": 11, "twelve": 12}
    if on("A9"):
        ran += 1
        for site in opt("A9", "count_sites", []):
            rx = re.compile(site["pattern"])
            actual = len(glob_files(ROOT, site["count_of"]))
            targets = [site["file"]] if site.get("file") else docs
            for d in targets:
                if d not in text_of:
                    continue
                for m in rx.finditer(without_struck(text_of[d])):
                    word = m.group(1)
                    stated = int(word) if word.isdigit() else WORDS.get(word.lower())
                    if stated is None or stated == actual:
                        continue
                    findings.append(finding(
                        "A9", d, line_of(text_of[d], m.start()), m.group(0),
                        f"states {word} ({stated}) where `{site['count_of']}` matches {actual}"))

    # ── A10. Every doc under docs/ is in the table, with a layer. ───────────
    if on("A10"):
        ran += 1
        if host not in text_of:
            findings.append(finding("A10", host, 1, "",
                f"`{host}` hosts the sources-of-truth table and is not in the repo"))
        elif not table:
            findings.append(finding("A10", host, 1, "",
                f"no sources-of-truth table found in `{host}` — every doc is unowned until "
                f"there is one"))
        else:
            patterns = [(r["doc"], glob_re(r["doc"]), r) for r in table]
            for d in docs:
                if not d.startswith("docs/"):
                    continue          # the table's own host is not under docs/
                row = next((r for _, rx, r in patterns if rx.match(d)), None)
                if row is None:
                    findings.append(finding("A10", d, 1, d,
                        f"`{d}` is under docs/ and has no row in `{host}` — a doc in the table "
                        f"or it is drift, there is no third state"))
                elif row["layer"] is None:
                    findings.append(finding("A10", host, row["line"], row["doc"],
                        f"the row for `{row['doc']}` has no layer — the layer is what fixes the "
                        f"edit rule and selects the assertions"))
                elif row["layer"] not in LAYER_NAMES:
                    findings.append(finding("A10", host, row["line"], row["doc"],
                        f"the row for `{row['doc']}` says layer {row['layer']}, which is not 1..6"))

    # ── A11. Config `load_bearing` and the table's Enforces column agree. ──
    if on("A11"):
        ran += 1
        load_bearing = cfg.get("load_bearing", [])
        globs = [glob_re(g) for g in load_bearing]
        for row in table:
            e = row["enforces"].strip()
            if not e:
                continue
            # A path-shaped value is held to `load_bearing`; a command is not. The plan allows an
            # Enforces cell to name "a constraint, an index, a CI assertion", and a CI assertion
            # is a command — which `load_bearing` must not carry, because the review policy and
            # the follow-up qualifier read that list as path globs.
            if " " in e or not re.search(r"[/.]", e):
                continue
            if not any(rx.match(e) for rx in globs) and e not in load_bearing:
                findings.append(finding("A11", host, row["line"], e,
                    f"the row for `{row['doc']}` says it is enforced by `{e}`, which is not on "
                    f"`load_bearing` in {CONFIG_PATH} — the two copies of what carries weight "
                    f"have drifted"))
        # The layer exists in the table and in the config. Nothing read the config's copy, so a
        # doc's layer could be two different things with nothing reconciling them — which is the
        # exact failure the method's central rule exists to prevent.
        by_path = {r["doc"]: r for r in table}
        for d in cfg.get("docs", []):
            row = by_path.get(d.get("path"))
            if row is None:
                findings.append(finding("A11", CONFIG_PATH, 1, d.get("path", ""),
                    f"{CONFIG_PATH} lists `{d.get('path')}` and `{host}` has no row for it"))
            elif row["layer"] is not None and d.get("layer") != row["layer"]:
                findings.append(finding("A11", host, row["line"], d.get("path", ""),
                    f"`{d.get('path')}` is layer {row['layer']} in the table and "
                    f"layer {d.get('layer')} in {CONFIG_PATH} — the layer fixes the edit rule, so "
                    f"two answers is two edit rules"))

    # ── A12. Append-only layers are byte-frozen on the default branch. ─────
    #
    # Layers 3 and 4 only, and only because their edit rule says a file already on the branch is
    # final: a record is never wrong, and an intent version is superseded rather than corrected.
    # A layer-2 doc is byte-frozen by nothing, correctly.
    if on("A12"):
        ran += 1
        branch = opt("A12", "default_branch", cfg.get("repo", {}).get("default_branch", "main"))
        frozen = [glob_re(r["doc"]) for r in table if r["layer"] in (3, 4)]
        try:
            subprocess.run(["git", "rev-parse", "--verify", branch], cwd=ROOT, check=True,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            have_branch = True
        except Exception:
            have_branch = False
        if not have_branch:
            findings.append(finding("A12", CONFIG_PATH, 1, branch,
                f"no branch called `{branch}` — the byte-freeze comparison was not made. Set "
                f"assertions.A12.default_branch, or switch A12 off; off is distinct from passing"))
        else:
            for d in docs:
                if not any(rx.match(d) for rx in frozen) or not frozen_record(d):
                    continue
                try:
                    was = subprocess.run(["git", "show", f"{branch}:{d}"], cwd=ROOT, check=True,
                                         stdout=subprocess.PIPE, stderr=subprocess.DEVNULL).stdout
                except Exception:
                    continue          # not on the branch yet: a new record, which is the point
                now = (ROOT / d).read_bytes()
                if was != now:
                    layer = next(r["layer"] for _, rx, r in
                                 [(x["doc"], glob_re(x["doc"]), x) for x in table] if rx.match(d))
                    findings.append(finding("A12", d, 1, d,
                        f"is layer {layer} ({LAYER_NAMES[layer]}) and already on `{branch}`, so "
                        f"its bytes are final. A reversal is a new entry; a correction is not "
                        f"available here"))

    # ── A13. The append-only layers keep their shape. ──────────────────────
    if on("A13"):
        ran += 1
        adr = cfg.get("adr", {})
        if adr.get("format") == "madr":
            d_dir = adr.get("dir", "docs/adr")
            for d in docs:
                if not d.startswith(d_dir + "/") or os.path.basename(d) in ("README.md", "template.md"):
                    continue
                text = text_of[d]
                if not re.search(r"^\*\*Date:\*\*", text, re.M):
                    findings.append(finding("A13", d, 1, "Date",
                        "a decision record carries a **Date:** — without one, \"what was decided "
                        "when\" has no answer and the append-only rule has nothing to anchor to"))
                m = re.search(r"^\*\*Status:\*\*[ \t]*(.*)$", text, re.M)
                if not m:
                    findings.append(finding("A13", d, 1, "Status",
                        "a decision record carries a **Status:** — proposed, accepted, or "
                        "superseded by NNNN"))
                elif "superseded" in m.group(1).lower():
                    succ = re.search(r"superseded by\s+(\d{4})", m.group(1), re.I)
                    if not succ:
                        findings.append(finding("A13", d, line_of(text, m.start()), m.group(1),
                            "a superseded record names its successor by number, or the reversal "
                            "is unfindable"))
                    elif not glob_files(ROOT, f"{d_dir}/{succ.group(1)}-*.md"):
                        findings.append(finding("A13", d, line_of(text, m.start()), succ.group(1),
                            f"names {succ.group(1)} as its successor, and there is no such record"))
        else:
            f = adr.get("file", "docs/decisions.md")
            if f in text_of:
                for m in re.finditer(r"^##[ \t]+(.*)$", text_of[f], re.M):
                    after = text_of[f][m.end():m.end() + 400]
                    if not re.search(r"\d{4}-\d{2}-\d{2}", after.split("\n##")[0]):
                        findings.append(finding("A13", f, line_of(text_of[f], m.start()),
                            m.group(1),
                            "a dated decisions file gives every entry a date — the layer is "
                            "append-only and dated, and the date is what makes it a record"))
        prd = cfg.get("prd", {})
        prd_dir = prd.get("dir", "docs/prd")
        index = f"{prd_dir}/README.md"
        if index in text_of:
            for d in docs:
                base = os.path.basename(d)
                if not d.startswith(prd_dir + "/") or not re.fullmatch(r"PRD-v\d+\.md", base):
                    continue
                # Findable by filename or by version label: an index row reading `| v0 | … |`
                # makes the version perfectly findable, and A13 exists so an unindexed version
                # cannot hide, not so the index has to spell a filename.
                label = base[4:-3]                       # PRD-v0.md -> v0
                indexed = base in text_of[index] or re.search(
                    r"(?<![\w-])" + re.escape(label) + r"(?![\w.-])", text_of[index])
                if not indexed:
                    findings.append(finding("A13", index, 1, base,
                        f"`{base}` is a PRD version and is named nowhere in the index — neither "
                        f"as the filename nor as `{label}`. An unindexed version is one nobody "
                        f"can find"))
        elif any(d.startswith(prd_dir + "/") for d in docs):
            findings.append(finding("A13", index, 1, "",
                f"`{prd_dir}/` has versions and no `README.md` index"))

    # ── A14. The units table has the shape it claims. ──────────────────────
    if on("A14"):
        ran += 1
        globs = opt("A14", "plan_glob", "docs/plans/*.md")
        globs = [globs] if isinstance(globs, str) else list(globs)
        res = [glob_re(g) for g in globs]
        # Enabled and matching nothing is not a pass: the same rule A8 follows.
        plans = [d for d in docs if any(rx.match(d) for rx in res)]
        if not plans:
            findings.append(finding("A14", CONFIG_PATH, 1, ", ".join(globs),
                f"assertions.A14 is enabled and `{', '.join(globs)}` matches no doc — the units "
                f"comparison was not made. Point it at the layer-5 rows, or switch A14 off; off "
                f"is distinct from passing"))
        # What counts as an assertion is the repo's to say: a Go table test fails through
        # `t.Fatalf` and contains no assertion word at all, so no default can be right for every
        # repo. A pattern that cannot be read the same way by both checkers is reported, and only
        # the comparison that needed it is skipped.
        pat = opt("A14", "assertion_pattern", DEFAULT_ASSERTION_PATTERN)
        assert_re = None
        why = portable_regex(pat) if isinstance(pat, str) else "it is not a string"
        if why is None:
            try:
                assert_re = re.compile(pat, re.A | re.M)
            except re.error:
                why = "it did not compile"
        if why is not None:
            shown = f" `{pat}`" if isinstance(pat, str) else ""
            findings.append(finding("A14", CONFIG_PATH, 1, pat if isinstance(pat, str) else "",
                f"assertions.A14.assertion_pattern{shown} could not be compiled — {why}. Whether "
                f"a test file asserts anything was not compared; the rest of A14 ran. Write the "
                f"pattern in the subset `references/assertions.md` § A14 describes, or remove the "
                f"key for the default"))
        for d in plans:
            text = text_of[d]
            body = section_body(text, "The units")
            if body is None:
                # Only a plan that sequences issues is a plan that owes its units. A layer-5 doc
                # with neither section is another kind of file under the same glob, and says
                # nothing here.
                if section_body(text, "The issues") is not None:
                    findings.append(finding("A14", d, 1, "The units",
                        "has a `§ The issues` and no `§ The units` — the units comparison was "
                        "not made. A plan names its units, each with the test that proves it, "
                        "or nothing says what \"done\" is"))
                continue
            # The body is a slice of the text, so where it is found is where its first line is.
            # Looking that line up by its content instead would send a blank first line to the
            # first blank line in the file.
            base = line_of(text, text.find(body))
            units = 0
            for i, line in enumerate(body.split("\n")):
                cells = table_cells(line)
                if cells is None:
                    continue
                # A bare numeral only: the header, the rule under it, and a struck-through unit
                # are not units, so none of them is held to the shape.
                if not re.fullmatch(r"\d+", cells[0], re.A):
                    continue
                units += 1
                proves = cells[2] if len(cells) > 2 else ""
                m = re.fullmatch(r"`([\w./-]+)`", proves, re.A)
                if not m:
                    findings.append(finding("A14", d, base + i, proves,
                        f"unit {cells[0]} has no test path in its \"Proves it\" cell — a unit is "
                        f"the smallest piece of work that carries its own test, so name the test "
                        f"as a backticked path"))
                    continue
                # Only a plain repo-relative file path is read. An absolute one resolves differently
                # in the two languages (pathlib's `/` replaces the root, join concatenates onto
                # it), a trailing `/` does too (pathlib drops it, so the file is found; a stat in
                # Node fails with ENOTDIR), and `..` leaves the repo, which a repo's own check has
                # no business reading.
                if (m.group(1).startswith("/") or m.group(1).endswith("/")
                        or ".." in m.group(1).split("/")):
                    findings.append(finding("A14", d, base + i, m.group(1),
                        f"unit {cells[0]} names `{m.group(1)}` as its test, and that is not a file "
                        f"path inside the repo — write it relative to the repo root, with no "
                        f"leading `/`, no trailing `/` and no `..`"))
                    continue
                # A file that is there and cannot be opened is not a missing one, and it must not
                # take the checker down: every assertion after this one would stop running, and
                # a crash exits nonzero, which looks the same as findings.
                state, content = "ok", ""
                try:
                    tp = ROOT / m.group(1)
                    tp.stat()
                    if tp.is_file():
                        content = tp.read_text(encoding="utf-8", errors="replace")
                    else:
                        state = "missing"
                except OSError as e:
                    state = "missing" if e.errno in (errno.ENOENT, errno.ENOTDIR) else "unreadable"
                if state == "missing":
                    findings.append(finding("A14", d, base + i, m.group(1),
                        f"unit {cells[0]} names `{m.group(1)}` as its test, and there is no such "
                        f"file"))
                elif state == "unreadable":
                    findings.append(finding("A14", d, base + i, m.group(1),
                        f"unit {cells[0]} names `{m.group(1)}` as its test, and the file could "
                        f"not be read — whether it asserts anything was not compared"))
                elif assert_re is not None:
                    # The pattern sees the file with line endings made `\n` and each run of
                    # non-ASCII characters made one `~`, so `.`, `\s` and `$` mean the same to
                    # both engines.
                    flat = re.sub(r"[^\x00-\x7f]+", "~", content.replace("\r\n", "\n").replace("\r", "\n"))
                    if not assert_re.search(flat):
                        findings.append(finding("A14", d, base + i, m.group(1),
                            f"unit {cells[0]} names `{m.group(1)}` as its test, and the file "
                            f"asserts nothing — nothing in it matches "
                            f"`assertions.A14.assertion_pattern`"))
            # A heading with nothing under it compared nothing, which is the missing section again.
            if units == 0:
                findings.append(finding("A14", d, 1, "The units",
                    "has a `§ The units` with no unit in it — the units comparison was not made. "
                    "A unit is a numbered row naming the test that proves it; a struck-through "
                    "row is not one"))

    # ── Repo-invented assertions. Discovered, never overwritten. ───────────
    adir = ROOT / ".seam" / "assertions"
    if adir.is_dir():
        ctx = {"root": str(ROOT), "config": cfg, "docs": docs, "text_of": text_of,
               "table": table, "host": host}
        for f in sorted(adir.glob("*.py")):
            spec = importlib.util.spec_from_file_location(f.stem, f)
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            if not hasattr(mod, "run"):
                print(f"seam: {f.name} has no run(ctx)", file=sys.stderr)
                continue
            ran += 1
            for r in mod.run(ctx) or []:
                findings.append(finding(r["id"], r["file"], int(r["line"]), r.get("text", ""),
                                        r["message"]))

    # ── The baseline ───────────────────────────────────────────────────────
    #
    # A debt with a number on it, NOT an approval — which is what keeps it separate from the
    # allow-list, whose entries carry a written reason and mean "this will never be fixed".
    # Matching is exact on (id, file, line, text), so a violation whose line no longer matches
    # drops out rather than being carried forever.
    bpath = ROOT / cfg.get("baseline", {}).get("path", ".seam/baseline.json")
    key = lambda f: (f["id"], f["file"], f["line"], f["text"])
    findings.sort(key=lambda f: (f["id"], f["file"], f["line"], f["text"]))

    if "--write-baseline" in sys.argv:
        bpath.parent.mkdir(parents=True, exist_ok=True)
        bpath.write_text(json.dumps({
            "seam_version": SEAM_VERSION,
            "note": "Day-one drift, recorded so the checker fails only on what is new. A debt "
                    "with a number on it, not an approval: an entry here is expected to go away.",
            "entries": [{"id": f["id"], "file": f["file"], "line": f["line"], "text": f["text"]}
                        for f in findings],
        }, indent=2) + "\n")
        print(f"seam {SEAM_VERSION}: baselined {len(findings)} violation(s) into "
              f"{bpath.relative_to(ROOT)}")
        return 0

    baselined = set()
    if bpath.exists():
        for e in json.loads(bpath.read_text()).get("entries", []):
            baselined.add((e["id"], e["file"], e["line"], e.get("text", "")))
    new = [f for f in findings if key(f) not in baselined]
    carried = len(findings) - len(new)

    print(f"seam {SEAM_VERSION}: {ran} assertions, {len(docs)} docs, {len(new)} violations "
          f"({carried} baselined)")
    if not new:
        return 0
    for f in new:
        print(f"{f['file']}:{f['line']}: {f['id']} {f['message']}", file=sys.stderr)
    print(f"\n{len(new)} violation(s) outside the baseline. The artifact is authoritative, and a "
          f"lower layer cites a higher one rather than restating it: fix the doc, or if the "
          f"change was deliberate, change what enforces it in the same commit.", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
