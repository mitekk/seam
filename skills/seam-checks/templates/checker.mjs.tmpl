#!/usr/bin/env node
// Assert this repo's docs still agree with each other and with the code.
//
// Generated by seam {{SEAM_VERSION}}. **Do not edit this file.** Every repo-specific knob lives
// in `{{CONFIG_PATH}}` and is read at run time, so regenerating is always safe — and a knob
// edited into this script is a knob the next regeneration silently drops. To add an assertion
// this repo needs and seam does not have, put it in `.seam/assertions/*.mjs`; those are
// discovered here and never overwritten.
//
// No dependencies, no network, deterministic. Run it:
//
//     node {{CHECKER_PATH}}                   # check
//     node {{CHECKER_PATH}} --write-baseline  # record today's violations as the baseline
//
// Exit 0: no violations outside the baseline. Exit 1: violations, listed on stderr.
//
// This is a line-for-line mirror of the Python emission. The two are compared on every fixture
// by the test suite, because "a repo can switch languages without changing what is enforced" is
// only true if it is checked.

import { readFileSync, writeFileSync, mkdirSync, existsSync, readdirSync, statSync } from "node:fs";
import { join, dirname, basename, relative, resolve, sep } from "node:path";
import { execFileSync } from "node:child_process";
import { fileURLToPath, pathToFileURL } from "node:url";

const SEAM_VERSION = "{{SEAM_VERSION}}";
const CONFIG_PATH = "{{CONFIG_PATH}}";

let ROOT = dirname(fileURLToPath(import.meta.url));
while (!existsSync(join(ROOT, CONFIG_PATH)) && dirname(ROOT) !== ROOT) ROOT = dirname(ROOT);

const LAYER_NAMES = { 1: "Artifact", 2: "Current", 3: "Decisions", 4: "Intent", 5: "Seam", 6: "Ledger" };

const MARK_START = "<!-- seam:sources-of-truth start -->";
const MARK_END = "<!-- seam:sources-of-truth end -->";

// `~~struck~~` is where a FORMER truth legitimately lives: the convention that lets a reader see
// why a line changed. Blanked for the assertions about vocabulary, keeping offsets so the line
// numbers stay true. Bounded to a span that does not cross a blank line, because an unbalanced
// `~~` would otherwise pair with the next one paragraphs away and silently swallow the text
// between — a check that stops checking rather than one that fails.
const STRUCK_RE = /~~(?:[^~\n]|\n(?!\n))*?~~/g;

const withoutStruck = (text) => text.replace(STRUCK_RE, (m) => m.replace(/[^\n]/g, " "));

function lineOf(text, index) {
  let n = 1;
  for (let i = 0; i < index && i < text.length; i++) if (text[i] === "\n") n++;
  return n;
}

function globRe(pattern) {
  let out = "";
  let i = 0;
  while (i < pattern.length) {
    if (pattern.startsWith("**/", i)) { out += "(?:.*/)?"; i += 3; }
    else if (pattern[i] === "*") { out += "[^/]*"; i += 1; }
    else if (pattern[i] === "?") { out += "[^/]"; i += 1; }
    else { out += pattern[i].replace(/[.*+?^${}()|[\]\\]/g, "\\$&"); i += 1; }
  }
  return new RegExp("^" + out + "$");
}

const SKIP = new Set([".git", "node_modules", "dist", "build", ".next", "vendor", "__pycache__",
  ".venv", "venv", "target", ".turbo", "coverage"]);

/** Every file in the repo, skipping nested checkouts and build output. */
function allFiles(root, dir = root, out = []) {
  let entries;
  try { entries = readdirSync(dir, { withFileTypes: true }); } catch { return out; }
  const names = entries.map((e) => e.name);
  if (dir !== root && names.includes(".git")) return out;
  for (const name of names.slice().sort()) {
    const e = entries.find((x) => x.name === name);
    if (e.isSymbolicLink()) continue;
    const abs = join(dir, name);
    if (e.isDirectory()) {
      if (SKIP.has(name)) continue;
      allFiles(root, abs, out);
    } else if (e.isFile()) {
      out.push(relative(root, abs).split(sep).join("/"));
    }
  }
  return out;
}

/** Files matching a path glob, from the same walk the rest of the checker uses. */
function globFiles(root, pattern) {
  const rx = globRe(pattern);
  return allFiles(root).filter((f) => rx.test(f)).sort();
}

/** Every markdown file under docs/ plus every one at the repo root. */
function walkMd(root) {
  return allFiles(root)
    .filter((f) => f.endsWith(".md") && (f.startsWith("docs/") || !f.includes("/")))
    .sort();
}

// ── Markdown reading ─────────────────────────────────────────────────────────

function headings(text) {
  const out = [];
  for (const m of text.matchAll(/^#{1,6}[ \t]+(.*)$/gm)) {
    const h = m[1].replaceAll("~~", "").replaceAll("**", "").replaceAll("*", "")
      .replaceAll("`", "").trim();
    if (h) out.push(h);
  }
  return out;
}

/** Every name a section of this file can legitimately be cited by. */
function anchors(text) {
  const out = new Set();
  for (const h of headings(text)) {
    out.add(h.toLowerCase());
    // Split on a comma as well as an em dash: "API, and what it refuses" is cited as
    // § API, and an em-dash-only split missed that shape repeatedly on a real repo.
    for (const clause of h.split(/ — |, /)) {
      const c = clause.trim();
      if (!c) continue;
      out.add(c.toLowerCase());
      const words = c.toLowerCase().split(/\s+/).filter(Boolean);
      for (let k = 1; k <= words.length; k++) out.add(words.slice(0, k).join(" "));
    }
  }
  return out;
}

function citesSection(anchorSet, cited) {
  const low = cited.split(/\s+/).filter(Boolean).join(" ").toLowerCase().replace(/\)+$/, "");
  for (const a of [...anchorSet].sort((x, y) => y.length - x.length)) {
    if (low.startsWith(a) && (low.length === a.length || !/[a-z0-9]/i.test(low[a.length]))) {
      return true;
    }
  }
  return false;
}

/** The lines under the heading called `name`; null when there is no such heading. */
function sectionBody(text, name) {
  const lines = text.split("\n");
  let start = null;
  let startLevel = 0;
  const low = name.toLowerCase();
  for (let i = 0; i < lines.length; i++) {
    // Levels 2 to 6: a `#` heading is the document's title, not a section of it. Without that
    // bound, `§ Checks` in a file called "# Checks" matched the title, whose body is the
    // whole file — so a renamed section still compared something and passed.
    const m = lines[i].match(/^(#{2,6})[ \t]+(.*)$/);
    if (!m) continue;
    const clean = m[2].replaceAll("~~", "").replaceAll("**", "").replaceAll("*", "")
      .trim().toLowerCase();
    if (start === null) {
      // The same rule citations use: the heading begins with the cited name, ending on a word
      // boundary — "The issues" names "The issues, in the order they can be built".
      if (clean.startsWith(low) && (clean.length === low.length || !/[a-z0-9]/i.test(clean[low.length]))) {
        start = i + 1;
        startLevel = m[1].length;
      }
      continue;
    }
    if (m[1].length <= startLevel) return lines.slice(start, i).join("\n");
  }
  return start === null ? null : lines.slice(start).join("\n");
}

const MD_CITE_RE = /`([\w./@-]+\.md)`/g;
// A `|` ends a section name: it is a table cell boundary and never part of a heading.
const TOKEN_RE = /`([^`\n]+)`|(?<![`\w./-])([\w./-]+\.md)(?![\w.-])|§[ \t\n]*([A-Za-z][^.;:—(*`§|\n]*)/g;
const ADJACENT_RE = /^[\s,*]{0,4}$/;
const CONNECTOR_RE = /^[\s,]*(?:and|or)?[\s,]*$/;

function resolveMd(root, frm, cited) {
  if (existsSync(join(root, cited))) return cited;
  const beside = resolve(dirname(join(root, frm)), cited);
  const rel = relative(root, beside).split(sep).join("/");
  return existsSync(beside) ? rel : null;
}

// What A12 freezes: a RECORD, not the file that indexes it. An index grows by design — adding a
// version means appending a row — and a "current" file is replaced wholesale when a new version
// lands. Freezing either makes the layer unusable, which is the opposite of enforcing its edit
// rule. A template is a form, not a record, so it is not frozen either.
const NOT_A_RECORD = new Set(["README.md", "template.md", "PRD-current.md", "index.md"]);

const frozenRecord = (path) => !NOT_A_RECORD.has(basename(path));

/** Every `*.md` path this file claims exists, with its offset.
 *
 *  A backticked path that is the TEXT of a markdown link is a label, not a citation: in
 *  ``[`api.md`](.claude/rules/api.md)`` the link target is the claim and the label is how it
 *  reads. Measured on a repo nothing was tuned against — a README listing eight rules that way
 *  reported eight dangling citations, every one of them wrong, while the targets all resolved. */
function mdCitations(root, frm, text) {
  const out = [];
  const linkedSpans = [];
  for (const m of text.matchAll(/\[([^\]\n]*)\]\(([^)\s]+)\)/g)) {
    const labelStart = m.index + 1;
    linkedSpans.push([labelStart, labelStart + m[1].length]);
    const target = m[2].split("#")[0];
    if (target.endsWith(".md")) out.push([target, m.index]);
  }
  for (const m of text.matchAll(MD_CITE_RE)) {
    const s = m.index + 1;
    const e = s + m[1].length;
    if (linkedSpans.some(([a, b]) => a <= s && e <= b)) continue;
    out.push([m[1], m.index]);
  }
  return out;
}

// ── The sources-of-truth table ───────────────────────────────────────────────

function readTable(text) {
  const start = text.indexOf(MARK_START);
  const end = text.indexOf(MARK_END);
  const scoped = start !== -1 && end > start;
  const body = scoped ? text.slice(start, end) : text;
  const offset = scoped ? start : 0;
  const rows = [];
  for (const m of body.matchAll(/^\|(.*)\|[ \t]*$/gm)) {
    const cells = m[1].split("|").map((c) => c.trim());
    const doc = cells.length ? cells[0].match(/^`([^`]+)`$/) : null;
    if (!doc) continue;
    let layer = null;
    if (cells.length > 1) {
      const lm = cells[1].match(/^(\d)\b/);
      if (lm) layer = Number(lm[1]);
    }
    rows.push({
      doc: doc[1],
      layer,
      owns: cells.length > 2 ? cells[2] : "",
      enforces: cells.length > 3 ? cells[3].replaceAll("`", "") : "",
      line: lineOf(text, offset + m.index),
    });
  }
  return rows;
}

// ── Artifact parsing ─────────────────────────────────────────────────────────

function sqlTables(sql) {
  const out = {};
  for (const m of sql.matchAll(/create table (?:if not exists )?(\w+)\s*\(([\s\S]*?)\n\);/gi)) {
    const cols = new Set([...m[2].matchAll(/^\s{2,}(\w+)\s/gm)].map((c) => c[1]));
    out[m[1]] = cols;
  }
  return out;
}

function sqlEnum(sql, name) {
  const rx = new RegExp("create type\\s+" + name.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")
    + "\\s+as enum\\s*\\(([\\s\\S]*?)\\);", "i");
  const m = sql.match(rx);
  return m ? new Set([...m[1].matchAll(/'([^']+)'/g)].map((x) => x[1])) : null;
}

function tsUnions(text) {
  const out = {};
  for (const m of text.matchAll(/(?:type|enum)\s+(\w+)\s*=?\s*\{?([^;}]*)[;}]/g)) {
    const members = new Set([...m[2].matchAll(/['"]([\w-]+)['"]/g)].map((x) => x[1]));
    if (members.size) out[m[1]] = members;
  }
  return out;
}

// ── A3: the documented check list against CI ─────────────────────────────────

// Right-hand sides that are not fields: file extensions and hostname endings. A dotted name
// whose right half is one of these is a path or a host, not a reference.
const DEFAULT_NOT_FIELDS = new Set([
  "md", "sql", "yml", "yaml", "json", "toml", "ini", "cfg", "txt", "csv", "xml", "html", "css",
  "py", "pyi", "mjs", "cjs", "js", "jsx", "ts", "tsx", "sh", "bash", "zsh", "rb", "go", "rs",
  "java", "kt", "swift", "php", "lock", "log", "env", "example", "tmpl", "png", "jpg", "svg",
  "webp", "ico", "pdf", "zip", "gz", "prisma", "proto", "graphql", "d",
  "com", "org", "net", "io", "dev", "sh2", "co", "me", "ai", "app", "so", "gov", "edu", "il",
  "uk", "de", "online",
]);

const DEFAULT_TOKEN_RES = [
  "scripts/[\\w.\\-/]+\\.(?:py|sql|mjs|js|ts|sh)",
  "(?:npm|pnpm|yarn|bun) run [\\w:.\\-]+",
  "node --test",
  "(?:^|&&|;|\\|)\\s*(?:pytest|ruff|mypy|eslint|tsc|cargo|go test)\\b",
  "check:[a-z\\-]+",
  "docker build",
  "drop schema public cascade",
];
const TURBO_RE = /turbo run ((?:[a-z]+ )*[a-z]+)/g;

/** Drop shell and YAML comments, keeping a quoted `#` as the content it is. */
function stripComments(text) {
  text = text.replace(/\\\n/g, " ");
  const out = [];
  for (const line of text.split("\n")) {
    let quote = "";
    let cut = null;
    for (let i = 0; i < line.length; i++) {
      const ch = line[i];
      if (quote) {
        if (ch === quote) quote = "";
      } else if (ch === "'" || ch === '"') {
        quote = ch;
      } else if (ch === "#" && (i === 0 || /\s/.test(line[i - 1]))) {
        cut = i;
        break;
      }
    }
    out.push(cut === null ? line : line.slice(0, cut));
  }
  return out.join("\n");
}

function checkTokens(text, extra) {
  text = stripComments(text);
  const found = new Set();
  for (const src of [...DEFAULT_TOKEN_RES, ...extra]) {
    for (const m of text.matchAll(new RegExp(src, "gm"))) {
      found.add(m[0].replace(/^[&|;\s\n\t]+/, ""));
    }
  }
  for (const m of text.matchAll(TURBO_RE)) {
    for (const task of m[1].split(" ")) found.add("turbo:" + task);
  }
  return found;
}

const RUN_KEY_RE = /^[ \t]*(?:-[ \t]+)?(run:)[ \t]*(\|[-+0-9]*)?[ \t]*(.*)$/;

/** Every `run:` payload in a workflow, with the line it starts on. */
function runPayloads(yamlText) {
  const lines = yamlText.split("\n");
  const out = [];
  let i = 0;
  while (i < lines.length) {
    const m = lines[i].match(RUN_KEY_RE);
    if (!m) { i += 1; continue; }
    const col = lines[i].indexOf("run:");
    const body = [m[3]];
    const start = i + 1;
    let j = i + 1;
    while (j < lines.length) {
      const line = lines[j];
      if (line.trim() === "") { body.push(""); j += 1; continue; }
      const indent = line.length - line.replace(/^\s+/, "").length;
      if (indent <= col) break;
      body.push(line);
      j += 1;
    }
    out.push([start, body.join("\n")]);
    i = j;
  }
  return out;
}

// ── Findings ─────────────────────────────────────────────────────────────────

const finding = (id, file, line, text, message) => ({ id, file, line, text, message });

const WORDS = { one: 1, two: 2, three: 3, four: 4, five: 5, six: 6, seven: 7, eight: 8,
  nine: 9, ten: 10, eleven: 11, twelve: 12 };

async function main() {
  const cfgFile = join(ROOT, CONFIG_PATH);
  if (!existsSync(cfgFile)) {
    process.stderr.write(`seam: no ${CONFIG_PATH} found above `
      + `${dirname(fileURLToPath(import.meta.url))}\n`);
    return 2;
  }
  const cfg = JSON.parse(readFileSync(cfgFile, "utf8"));
  const A = cfg.assertions ?? {};
  const on = (k) => Boolean(A[k]?.enabled);
  const opt = (k, name, dflt = undefined) => (A[k]?.[name] !== undefined ? A[k][name] : dflt);

  const host = cfg.table.file;
  const docs = walkMd(ROOT);
  const textOf = {};
  for (const d of docs) if (existsSync(join(ROOT, d))) textOf[d] = readFileSync(join(ROOT, d), "utf8");
  const anchorsOf = {};
  for (const [d, t] of Object.entries(textOf)) anchorsOf[d] = anchors(t);
  const table = readTable(textOf[host] ?? "");
  const findings = [];
  let ran = 0;

  // ── A1. Every `*.md` path cited in backticks resolves. ───────────────────
  if (on("A1")) {
    ran += 1;
    const allowed = new Set((opt("A1", "allow", [])).map((e) => e.path));
    for (const d of docs) {
      for (const [cited, at] of mdCitations(ROOT, d, textOf[d])) {
        if (cited.includes("*") || allowed.has(cited)) continue;
        if (resolveMd(ROOT, d, cited) === null) {
          findings.push(finding("A1", d, lineOf(textOf[d], at), cited,
            `cites \`${cited}\`, which is not in the repo — fix or drop the citation, or add it `
            + `to assertions.A1.allow with a reason`));
        }
      }
    }
  }

  // ── A2. Every `§ Section` citation names a heading that exists. ──────────
  if (on("A2")) {
    ran += 1;
    const bareToo = Boolean(opt("A2", "bare_sections", false));
    for (const d of docs) {
      const text = textOf[d];
      let base = 0;
      for (const para of text.split(/\n[ \t]*\n/)) {
        let target = null;
        let targetEnd = -1;
        let shadow = null;
        let shadowEnd = -1;
        for (const m of para.matchAll(TOKEN_RE)) {
          const backticked = m[1];
          const bare = m[2];
          const name = m[3];
          if (backticked !== undefined || bare !== undefined) {
            const tok = (backticked !== undefined ? backticked : bare).trim();
            if (/^[\w./@-]+\.md$/.test(tok) && !tok.includes("*")) {
              target = resolveMd(ROOT, d, tok) ?? tok;
              targetEnd = m.index + m[0].length;
              shadow = null;
            } else if (backticked !== undefined && /^[\w./@-]+$/.test(tok)) {
              shadow = tok;
              shadowEnd = m.index + m[0].length;
            } else {
              shadow = null;
            }
            continue;
          }
          const cited = name.trim();
          if (shadow !== null && m.index - shadowEnd <= 4
              && ADJACENT_RE.test(para.slice(shadowEnd, m.index))) {
            shadow = null;
            continue;
          }
          let targeted = false;
          let file = d;
          if (target !== null) {
            const gap = para.slice(targetEnd, m.index);
            if (ADJACENT_RE.test(gap) || CONNECTOR_RE.test(gap)) {
              file = target;
              targeted = true;
              targetEnd = m.index + m[0].length;
            } else {
              target = null;
            }
          }
          if (!targeted && !bareToo) continue;
          let aset = anchorsOf[file];
          if (aset === undefined) {
            if (!existsSync(join(ROOT, file))) continue;   // A1 owns a path that does not resolve
            aset = anchors(readFileSync(join(ROOT, file), "utf8"));
            anchorsOf[file] = aset;
          }
          if (!citesSection(aset, cited)) {
            findings.push(finding("A2", d, base + lineOf(para, m.index), `${file} § ${cited}`,
              `cites \`${file}\` § ${cited}, which names no heading there`));
          }
        }
        base += (para.match(/\n/g)?.length ?? 0) + 2;
      }
    }
  }

  // ── A3. The documented check list and CI name the same commands. ─────────
  if (on("A3")) {
    ran += 1;
    const localOnly = new Set(opt("A3", "local_only", []));
    const ciOnly = new Set(opt("A3", "ci_only", []));
    const extra = opt("A3", "extra_tokens", []);
    const documented = new Map();
    let scoped = true;
    for (const site of opt("A3", "doc_sections", [])) {
      const f = site.file;
      const name = site.section;
      if (!(f in textOf)) {
        findings.push(finding("A3", f, 1, name,
          `assertions.A3 names \`${f}\`, which is not a doc here — the comparison against CI `
          + `was not made`));
        scoped = false;
        continue;
      }
      const body = sectionBody(textOf[f], name);
      if (body === null) {
        findings.push(finding("A3", f, 1, name,
          `no section called § ${name} in \`${f}\` — the comparison against CI was not `
          + `made, which a renamed heading would otherwise do silently`));
        scoped = false;
        continue;
      }
      const blocks = [...body.matchAll(/```bash\n([\s\S]*?)```/g)].map((b) => b[1]);
      if (!blocks.length) {
        findings.push(finding("A3", f, 1, name,
          `§ ${name} in \`${f}\` has no \`\`\`bash block — the comparison against CI was `
          + `not made`));
        scoped = false;
        continue;
      }
      let joined = blocks.join("\n");
      for (const lit of localOnly) joined = joined.replaceAll(lit, "");
      const at = textOf[f].indexOf(name);
      for (const tok of checkTokens(joined, extra)) {
        if (!documented.has(tok)) documented.set(tok, [f, lineOf(textOf[f], at >= 0 ? at : 0)]);
      }
    }
    if (scoped) {
      const glob = opt("A3", "workflow_glob", ".github/workflows/*.yml");
      const workflows = globFiles(ROOT, glob);
      if (!workflows.length) {
        findings.push(finding("A3", glob, 1, "",
          "no workflow matches assertions.A3.workflow_glob — the comparison was not made. "
          + "Switch A3 off until CI exists; off is distinct from passing"));
      } else {
        const inCi = new Map();
        for (const rel of workflows) {
          for (const [lineNo, payload] of runPayloads(readFileSync(join(ROOT, rel), "utf8"))) {
            for (const tok of checkTokens(payload, extra)) {
              if (!inCi.has(tok)) inCi.set(tok, [rel, lineNo]);
            }
          }
        }
        for (const [tok, [f, ln]] of [...documented.entries()].sort()) {
          if (!inCi.has(tok) && !ciOnly.has(tok)) {
            findings.push(finding("A3", f, ln, tok,
              `\`${tok}\` is documented as a check but no CI step runs it`));
          }
        }
        for (const [tok, [f, ln]] of [...inCi.entries()].sort()) {
          if (!documented.has(tok) && !localOnly.has(tok)) {
            findings.push(finding("A3", f, ln, tok,
              `CI runs \`${tok}\` but no documented check list names it`));
          }
        }
      }
    }
  }

  // ── A4. Every `<identifier>.<field>` in prose resolves. ──────────────────
  if (on("A4")) {
    ran += 1;
    // A built-in default, because an empty list is not a sensible one: on a real repo it read
    // `jobs.py` and `apiaries.io` as table columns. The config ADDS to this rather than replacing
    // it, so a repo cannot lose the defaults by naming one exemption of its own.
    const notFields = new Set([...DEFAULT_NOT_FIELDS, ...opt("A4", "not_fields", [])]);
    const notRefs = new Set(opt("A4", "not_references", []));
    const tables = {};
    for (const art of opt("A4", "artifacts", [])) {
      const p = join(ROOT, art.path);
      if (!existsSync(p)) {
        findings.push(finding("A4", art.path, 1, "",
          "assertions.A4 names this artifact, which is not in the repo — nothing was resolved "
          + "against it"));
        continue;
      }
      if (art.parser === "sql") Object.assign(tables, sqlTables(readFileSync(p, "utf8")));
      else if (art.parser === "ts") Object.assign(tables, tsUnions(readFileSync(p, "utf8")));
    }
    if (Object.keys(tables).length) {
      for (const d of docs) {
        for (const m of textOf[d].matchAll(/`(\w+)\.(\w+)`/g)) {
          const whole = m[0].replaceAll("`", "");
          const left = m[1];
          const right = m[2];
          if (notFields.has(right) || notRefs.has(whole) || !(left in tables)) continue;
          if (!tables[left].has(right)) {
            findings.push(finding("A4", d, lineOf(textOf[d], m.index), whole,
              `\`${whole}\` does not resolve: \`${left}\` has no \`${right}\`. The artifact is `
              + `authoritative`));
          }
        }
      }
    }
  }

  // ── A5. A vocabulary block names exactly the members the artifact defines. ──
  if (on("A5")) {
    ran += 1;
    for (const v of opt("A5", "vocabularies", [])) {
      const f = v.file;
      const name = v.section;
      if (!(f in textOf)) {
        findings.push(finding("A5", f, 1, name,
          `assertions.A5 names \`${f}\`, which is not a doc here`));
        continue;
      }
      const body = sectionBody(withoutStruck(textOf[f]), name);
      if (body === null) {
        findings.push(finding("A5", f, 1, name,
          `no section called § ${name} in \`${f}\` — the vocabulary was not compared`));
        continue;
      }
      const blocks = [...body.matchAll(/```[\w]*\n([\s\S]*?)```/g)].map((b) => b[1]);
      if (!blocks.length) {
        findings.push(finding("A5", f, 1, name,
          `§ ${name} in \`${f}\` has no fenced block — the vocabulary was not compared`));
        continue;
      }
      const stated = new Set(blocks.join("\n").split(/[\s,]+/).map((w) => w.trim()).filter(Boolean));
      let defined = null;
      for (const art of (opt("A4", "artifacts", null) ?? cfg.artifacts ?? [])) {
        const p = join(ROOT, art.path);
        if (!existsSync(p)) continue;
        if (art.parser === "sql") defined = sqlEnum(readFileSync(p, "utf8"), v.enum);
        else if (art.parser === "ts") defined = tsUnions(readFileSync(p, "utf8"))[v.enum] ?? null;
        if (defined !== null) break;
      }
      const at = lineOf(textOf[f], Math.max(textOf[f].indexOf(name), 0));
      if (defined === null) {
        findings.push(finding("A5", f, at, v.enum,
          `the artifact defines no vocabulary called \`${v.enum}\``));
        continue;
      }
      for (const extraMember of [...stated].filter((x) => !defined.has(x)).sort()) {
        findings.push(finding("A5", f, at, extraMember,
          `§ ${name} lists \`${extraMember}\`, which the artifact does not define`));
      }
      for (const missing of [...defined].filter((x) => !stated.has(x)).sort()) {
        findings.push(finding("A5", f, at, missing,
          `the artifact defines \`${missing}\`, which § ${name} does not list`));
      }
    }
  }

  // ── A6. A retired name never reappears. ─────────────────────────────────
  if (on("A6")) {
    ran += 1;
    for (const entry of opt("A6", "retired", [])) {
      const rx = new RegExp("\\b" + entry.name.replace(/[.*+?^${}()|[\]\\]/g, "\\$&") + "\\b", "gi");
      for (const d of docs) {
        for (const m of withoutStruck(textOf[d]).matchAll(rx)) {
          findings.push(finding("A6", d, lineOf(textOf[d], m.index), entry.name,
            `\`${entry.name}\` is retired — it became \`${entry.became ?? "?"}\` `
            + `(${entry.reason ?? "no reason recorded"})`));
        }
      }
    }
  }

  // ── A7. A reversed decision is not prescribed again. ────────────────────
  if (on("A7")) {
    ran += 1;
    for (const entry of opt("A7", "reversed", [])) {
      const rx = new RegExp(entry.pattern, "g");
      for (const d of docs) {
        for (const m of withoutStruck(textOf[d]).matchAll(rx)) {
          const where = entry.adr ?? "the decision record";
          findings.push(finding("A7", d, lineOf(textOf[d], m.index), m[0],
            `prescribes a reversed decision: ${entry.reason} — see \`${where}\``));
        }
      }
    }
  }

  // ── A8. One issue, one owning plan. ─────────────────────────────────────
  if (on("A8")) {
    ran += 1;
    const rx = globRe(opt("A8", "plan_glob", "docs/plans/*.md"));
    const owners = new Map();
    for (const d of docs) {
      if (!rx.test(d)) continue;
      const body = sectionBody(textOf[d], "The issues");
      if (body === null) continue;
      const first = body.split("\n")[0];
      const base = body.trim() ? textOf[d].split("\n").indexOf(first) + 1 : 0;
      const lines = body.split("\n");
      for (let i = 0; i < lines.length; i++) {
        const line = lines[i];
        if (!line.trim().startsWith("|")) continue;
        const cells = line.trim().replace(/^\|/, "").replace(/\|$/, "").split("|")
          .map((c) => c.trim());
        if (cells.length < 2 || !/^~*\d+~*$/.test(cells[0])) continue;
        const m = cells[1].match(/#(\d+)/);
        if (m) {
          if (!owners.has(m[1])) owners.set(m[1], []);
          owners.get(m[1]).push([d, base + i]);
        }
      }
    }
    for (const [issue, places] of [...owners.entries()].sort((a, b) => Number(a[0]) - Number(b[0]))) {
      if (new Set(places.map((p) => p[0])).size > 1) {
        const where = [...new Set(places.map((p) => p[0]))].sort().join(", ");
        for (const [f, ln] of places.slice().sort()) {
          findings.push(finding("A8", f, ln, "#" + issue,
            `#${issue} is owned by more than one plan (${where}) — one issue, one owning plan, `
            + `so "where is this tracked" has one answer`));
        }
      }
    }
  }

  // ── A9. A stated count matches a computed one. ──────────────────────────
  if (on("A9")) {
    ran += 1;
    for (const site of opt("A9", "count_sites", [])) {
      const rx = new RegExp(site.pattern, "g");
      const actual = globFiles(ROOT, site.count_of).length;
      const targets = site.file ? [site.file] : docs;
      for (const d of targets) {
        if (!(d in textOf)) continue;
        for (const m of withoutStruck(textOf[d]).matchAll(rx)) {
          const word = m[1];
          const stated = /^\d+$/.test(word) ? Number(word) : WORDS[word.toLowerCase()];
          if (stated === undefined || stated === actual) continue;
          findings.push(finding("A9", d, lineOf(textOf[d], m.index), m[0],
            `states ${word} (${stated}) where \`${site.count_of}\` matches ${actual}`));
        }
      }
    }
  }

  // ── A10. Every doc under docs/ is in the table, with a layer. ───────────
  if (on("A10")) {
    ran += 1;
    if (!(host in textOf)) {
      findings.push(finding("A10", host, 1, "",
        `\`${host}\` hosts the sources-of-truth table and is not in the repo`));
    } else if (!table.length) {
      findings.push(finding("A10", host, 1, "",
        `no sources-of-truth table found in \`${host}\` — every doc is unowned until there is one`));
    } else {
      const patterns = table.map((r) => [globRe(r.doc), r]);
      for (const d of docs) {
        if (!d.startsWith("docs/")) continue;
        const hit = patterns.find(([rx]) => rx.test(d));
        const row = hit ? hit[1] : null;
        if (row === null) {
          findings.push(finding("A10", d, 1, d,
            `\`${d}\` is under docs/ and has no row in \`${host}\` — a doc in the table or it is `
            + `drift, there is no third state`));
        } else if (row.layer === null) {
          findings.push(finding("A10", host, row.line, row.doc,
            `the row for \`${row.doc}\` has no layer — the layer is what fixes the edit rule and `
            + `selects the assertions`));
        } else if (!(row.layer in LAYER_NAMES)) {
          findings.push(finding("A10", host, row.line, row.doc,
            `the row for \`${row.doc}\` says layer ${row.layer}, which is not 1..6`));
        }
      }
    }
  }

  // ── A11. Config `load_bearing` and the table's Enforces column agree. ──
  if (on("A11")) {
    ran += 1;
    const loadBearing = cfg.load_bearing ?? [];
    const globs = loadBearing.map(globRe);
    for (const row of table) {
      const e = row.enforces.trim();
      if (!e) continue;
      if (!globs.some((rx) => rx.test(e)) && !loadBearing.includes(e)) {
        findings.push(finding("A11", host, row.line, e,
          `the row for \`${row.doc}\` says it is enforced by \`${e}\`, which is not on `
          + `\`load_bearing\` in ${CONFIG_PATH} — the two copies of what carries weight have `
          + `drifted`));
      }
    }
  }

  // ── A12. Append-only layers are byte-frozen on the default branch. ─────
  if (on("A12")) {
    ran += 1;
    const branch = opt("A12", "default_branch", cfg.repo?.default_branch ?? "main");
    const frozen = table.filter((r) => r.layer === 3 || r.layer === 4).map((r) => globRe(r.doc));
    let haveBranch = true;
    try {
      execFileSync("git", ["rev-parse", "--verify", branch],
        { cwd: ROOT, stdio: ["ignore", "ignore", "ignore"] });
    } catch { haveBranch = false; }
    if (!haveBranch) {
      findings.push(finding("A12", CONFIG_PATH, 1, branch,
        `no branch called \`${branch}\` — the byte-freeze comparison was not made. Set `
        + `assertions.A12.default_branch, or switch A12 off; off is distinct from passing`));
    } else {
      for (const d of docs) {
        if (!frozen.some((rx) => rx.test(d)) || !frozenRecord(d)) continue;
        let was;
        try {
          was = execFileSync("git", ["show", `${branch}:${d}`],
            { cwd: ROOT, stdio: ["ignore", "pipe", "ignore"] });
        } catch { continue; }       // not on the branch yet: a new record, which is the point
        const now = readFileSync(join(ROOT, d));
        if (!was.equals(now)) {
          const layer = table.find((r) => globRe(r.doc).test(d)).layer;
          findings.push(finding("A12", d, 1, d,
            `is layer ${layer} (${LAYER_NAMES[layer]}) and already on \`${branch}\`, so its `
            + `bytes are final. A reversal is a new entry; a correction is not available here`));
        }
      }
    }
  }

  // ── A13. The append-only layers keep their shape. ──────────────────────
  if (on("A13")) {
    ran += 1;
    const adr = cfg.adr ?? {};
    if (adr.format === "madr") {
      const dDir = adr.dir ?? "docs/adr";
      for (const d of docs) {
        if (!d.startsWith(dDir + "/")) continue;
        if (basename(d) === "README.md" || basename(d) === "template.md") continue;
        const text = textOf[d];
        if (!/^\*\*Date:\*\*/m.test(text)) {
          findings.push(finding("A13", d, 1, "Date",
            "a decision record carries a **Date:** — without one, \"what was decided when\" has "
            + "no answer and the append-only rule has nothing to anchor to"));
        }
        const m = text.match(/^\*\*Status:\*\*[ \t]*(.*)$/m);
        if (!m) {
          findings.push(finding("A13", d, 1, "Status",
            "a decision record carries a **Status:** — proposed, accepted, or superseded by NNNN"));
        } else if (m[1].toLowerCase().includes("superseded")) {
          const succ = m[1].match(/superseded by\s+(\d{4})/i);
          if (!succ) {
            findings.push(finding("A13", d, lineOf(text, m.index), m[1],
              "a superseded record names its successor by number, or the reversal is unfindable"));
          } else if (!globFiles(ROOT, `${dDir}/${succ[1]}-*.md`).length) {
            findings.push(finding("A13", d, lineOf(text, m.index), succ[1],
              `names ${succ[1]} as its successor, and there is no such record`));
          }
        }
      }
    } else {
      const f = adr.file ?? "docs/decisions.md";
      if (f in textOf) {
        for (const m of textOf[f].matchAll(/^##[ \t]+(.*)$/gm)) {
          const after = textOf[f].slice(m.index + m[0].length, m.index + m[0].length + 400);
          if (!/\d{4}-\d{2}-\d{2}/.test(after.split("\n##")[0])) {
            findings.push(finding("A13", f, lineOf(textOf[f], m.index), m[1],
              "a dated decisions file gives every entry a date — the layer is append-only and "
              + "dated, and the date is what makes it a record"));
          }
        }
      }
    }
    const prdDir = cfg.prd?.dir ?? "docs/prd";
    const index = `${prdDir}/README.md`;
    if (index in textOf) {
      for (const d of docs) {
        const base = basename(d);
        if (!d.startsWith(prdDir + "/") || !/^PRD-v\d+\.md$/.test(base)) continue;
        // Findable by filename or by version label: an index row reading `| v0 | … |` makes the
        // version perfectly findable, and A13 exists so an unindexed version cannot hide, not so
        // the index has to spell a filename.
        const label = base.slice(4, -3);                 // PRD-v0.md -> v0
        const byLabel = new RegExp("(?<![\\w-])" + label.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")
          + "(?![\\w.-])");
        if (!textOf[index].includes(base) && !byLabel.test(textOf[index])) {
          findings.push(finding("A13", index, 1, base,
            `\`${base}\` is a PRD version and is named nowhere in the index — neither as the `
            + `filename nor as \`${label}\`. An unindexed version is one nobody can find`));
        }
      }
    } else if (docs.some((d) => d.startsWith(prdDir + "/"))) {
      findings.push(finding("A13", index, 1, "",
        `\`${prdDir}/\` has versions and no \`README.md\` index`));
    }
  }

  // ── Repo-invented assertions. Discovered, never overwritten. ───────────
  const adir = join(ROOT, ".seam", "assertions");
  if (existsSync(adir) && statSync(adir).isDirectory()) {
    const ctx = { root: ROOT, config: cfg, docs, text_of: textOf, table, host };
    for (const f of readdirSync(adir).filter((x) => x.endsWith(".mjs")).sort()) {
      const mod = await import(pathToFileURL(join(adir, f)).href);
      if (typeof mod.run !== "function") {
        process.stderr.write(`seam: ${f} has no run(ctx)\n`);
        continue;
      }
      ran += 1;
      for (const r of (await mod.run(ctx)) ?? []) {
        findings.push(finding(r.id, r.file, Number(r.line), r.text ?? "", r.message));
      }
    }
  }

  // ── The baseline ───────────────────────────────────────────────────────
  const bpath = join(ROOT, cfg.baseline?.path ?? ".seam/baseline.json");
  const key = (f) => JSON.stringify([f.id, f.file, f.line, f.text]);
  findings.sort((a, b) =>
    a.id.localeCompare(b.id) || a.file.localeCompare(b.file) || a.line - b.line
    || a.text.localeCompare(b.text));

  if (process.argv.includes("--write-baseline")) {
    mkdirSync(dirname(bpath), { recursive: true });
    writeFileSync(bpath, JSON.stringify({
      seam_version: SEAM_VERSION,
      note: "Day-one drift, recorded so the checker fails only on what is new. A debt with a "
        + "number on it, not an approval: an entry here is expected to go away.",
      entries: findings.map((f) => ({ id: f.id, file: f.file, line: f.line, text: f.text })),
    }, null, 2) + "\n");
    process.stdout.write(`seam ${SEAM_VERSION}: baselined ${findings.length} violation(s) into `
      + `${relative(ROOT, bpath).split(sep).join("/")}\n`);
    return 0;
  }

  const baselined = new Set();
  if (existsSync(bpath)) {
    for (const e of (JSON.parse(readFileSync(bpath, "utf8")).entries ?? [])) {
      baselined.add(JSON.stringify([e.id, e.file, e.line, e.text ?? ""]));
    }
  }
  const fresh = findings.filter((f) => !baselined.has(key(f)));
  const carried = findings.length - fresh.length;

  process.stdout.write(`seam ${SEAM_VERSION}: ${ran} assertions, ${docs.length} docs, `
    + `${fresh.length} violations (${carried} baselined)\n`);
  if (!fresh.length) return 0;
  for (const f of fresh) {
    process.stderr.write(`${f.file}:${f.line}: ${f.id} ${f.message}\n`);
  }
  process.stderr.write(`\n${fresh.length} violation(s) outside the baseline. The artifact is `
    + `authoritative, and a lower layer cites a higher one rather than restating it: fix the `
    + `doc, or if the change was deliberate, change what enforces it in the same commit.\n`);
  return 1;
}

process.exit(await main());
