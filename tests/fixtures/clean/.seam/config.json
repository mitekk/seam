{
  "seam_version": "0.1.0",
  "repo": { "name": "apiary", "default_branch": "main" },
  "table": { "file": "CLAUDE.md" },
  "checker": { "language": "python", "path": "scripts/check_docs.py" },
  "adr": { "format": "madr", "dir": "docs/adr" },
  "prd": { "dir": "docs/prd", "version": 1 },
  "artifacts": [{ "path": "db/schema.sql", "parser": "sql" }],
  "docs": [
    { "path": "docs/engineering.md", "layer": 2, "enforces": "", "create": true },
    { "path": "docs/checks.md", "layer": 2, "enforces": "", "create": true },
    { "path": "docs/adr/*.md", "layer": 3, "enforces": "", "create": true },
    { "path": "docs/prd/*.md", "layer": 4, "enforces": "", "create": true },
    { "path": "docs/plans/*.md", "layer": 5, "enforces": "", "create": true },
    { "path": "docs/findings-ledger.md", "layer": 6, "enforces": "", "create": true }
  ],
  "load_bearing": ["db/schema.sql"],
  "low_review_paths": [],
  "domains": [{ "name": "hives" }],
  "milestones": [{ "n": 1, "title": "Queenless list" }],
  "agents": [],
  "assertions": {
    "A1": { "enabled": true, "allow": [{ "path": "AGENTS.md", "reason": "generated by the build, off on purpose" }] },
    "A2": { "enabled": true, "bare_sections": false },
    "A3": {
      "enabled": true,
      "doc_sections": [{ "file": "docs/checks.md", "section": "Checks" }],
      "workflow_glob": ".github/workflows/*.yml",
      "local_only": ["docker compose up -d"],
      "ci_only": []
    },
    "A4": {
      "enabled": true,
      "artifacts": [{ "path": "db/schema.sql", "parser": "sql" }],
      "not_references": [],
      "not_fields": ["md", "sql", "yml", "yaml", "json", "py", "mjs", "js", "ts", "sh", "com", "dev", "io"]
    },
    "A5": {
      "enabled": true,
      "vocabularies": [{ "file": "docs/engineering.md", "section": "Hive states", "enum": "hive_state" }]
    },
    "A6": {
      "enabled": true,
      "retired": [{ "name": "beehives", "became": "hives", "reason": "the table was renamed; prose kept the old name" }]
    },
    "A7": {
      "enabled": true,
      "reversed": [{
        "pattern": "\\*\\*Use a queue library\\*\\*",
        "reason": "a queue library was rejected; the queue is a plain table",
        "adr": "docs/adr/0001-use-a-plain-table-for-the-queue.md"
      }]
    },
    "A8": { "enabled": true, "plan_glob": "docs/plans/*.md" },
    "A9": {
      "enabled": true,
      "count_sites": [{ "pattern": "\\*\\*(\\w+)\\*\\* plan files", "count_of": "docs/plans/*.md" }]
    },
    "A10": { "enabled": true },
    "A11": { "enabled": true },
    "A12": { "enabled": true, "default_branch": "main" },
    "A13": { "enabled": true }
  },
  "baseline": { "path": ".seam/baseline.json" }
}
