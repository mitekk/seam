{
  "seam_version": "0.2.0",
  "repo": {
    "name": "seam",
    "default_branch": "master"
  },
  "field": "brownfield",
  "table": {
    "file": "docs/contributing.md"
  },
  "checker": {
    "language": "node",
    "path": "scripts/check_docs.mjs"
  },
  "adr": {
    "format": "single",
    "file": "docs/decisions.md"
  },
  "prd": {
    "dir": "docs/prd",
    "version": 1
  },
  "artifacts": [],
  "docs": [
    {
      "path": "docs/contributing.md",
      "layer": 2,
      "enforces": "claude plugin validate --strict .",
      "create": false
    },
    {
      "path": "docs/taxonomy.md",
      "layer": 2,
      "enforces": "scripts/bootstrap-tracker.sh",
      "create": false
    },
    {
      "path": "docs/building.md",
      "layer": 2,
      "enforces": "",
      "create": true
    },
    {
      "path": "docs/context.md",
      "layer": 2,
      "enforces": "",
      "create": true
    },
    {
      "path": "docs/routing.md",
      "layer": 2,
      "enforces": "",
      "create": true
    },
    {
      "path": "docs/decisions.md",
      "layer": 3,
      "enforces": "node --test tests/red-proof.test.mjs",
      "create": true
    },
    {
      "path": "docs/superpowers/specs/*.md",
      "layer": 5,
      "enforces": "",
      "create": false
    },
    {
      "path": "docs/superpowers/plans/*.md",
      "layer": 5,
      "enforces": "",
      "create": false
    },
    {
      "path": "docs/findings-ledger.md",
      "layer": 6,
      "enforces": "",
      "create": true
    }
  ],
  "load_bearing": [
    "bin/**",
    "skills/seam-checks/templates/**",
    ".claude-plugin/**",
    "scripts/bootstrap-tracker.sh"
  ],
  "low_review_paths": [],
  "teardown_command": "",
  "domains": [
    {
      "name": "wizard"
    },
    {
      "name": "checker"
    },
    {
      "name": "github"
    },
    {
      "name": "review"
    },
    {
      "name": "plugin"
    },
    {
      "name": "tests"
    },
    {
      "name": "docs"
    }
  ],
  "milestones": [
    {
      "n": 2,
      "title": "Skeleton",
      "active": false
    },
    {
      "n": 3,
      "title": "The doc wizard, greenfield",
      "active": false
    },
    {
      "n": 4,
      "title": "The adopt path",
      "active": false
    },
    {
      "n": 5,
      "title": "The drift checker",
      "active": false
    },
    {
      "n": 6,
      "title": "GitHub conventions",
      "active": false
    },
    {
      "n": 7,
      "title": "The review policy",
      "active": false
    },
    {
      "n": 8,
      "title": "First real adoption",
      "active": true
    }
  ],
  "agents": [],
  "assertions": {
    "A1": {
      "enabled": true,
      "allow": [
        {
          "path": "CLAUDE.md",
          "reason": "the DEFAULT NAME of the table's host file in an adopting repo, not a file here — seam's own host is docs/contributing.md, and that file's § Sources of truth explains why"
        },
        {
          "path": "SKILL.md",
          "reason": "a filename form: skills/<name>/SKILL.md. Every real one is cited with its directory and resolves"
        },
        {
          "path": "prompt.md",
          "reason": "the filename inside an eval case directory, cited as a form. Every real one is at evals/<case>/prompt.md and resolves"
        }
      ],
      "intent_globs": [
        "docs/superpowers/plans/*.md"
      ]
    },
    "A2": {
      "enabled": true,
      "bare_sections": false
    },
    "A3": {
      "enabled": true,
      "doc_sections": [
        {
          "file": "docs/contributing.md",
          "section": "Checks"
        }
      ],
      "workflow_glob": ".github/workflows/*.yml",
      "extra_tokens": [
        "claude plugin validate"
      ],
      "local_only": [],
      "ci_only": []
    },
    "A4": {
      "enabled": false,
      "artifacts": []
    },
    "A5": {
      "enabled": false,
      "vocabularies": []
    },
    "A6": {
      "enabled": false,
      "retired": []
    },
    "A7": {
      "enabled": false,
      "reversed": []
    },
    "A8": {
      "enabled": true,
      "plan_glob": [
        "docs/superpowers/specs/*.md",
        "docs/superpowers/plans/*.md"
      ]
    },
    "A9": {
      "enabled": false,
      "count_sites": []
    },
    "A10": {
      "enabled": true
    },
    "A11": {
      "enabled": true
    },
    "A12": {
      "enabled": true,
      "default_branch": "master"
    },
    "A13": {
      "enabled": true
    },
    "A14": {
      "enabled": true,
      "plan_glob": [
        "docs/superpowers/specs/*.md",
        "docs/superpowers/plans/*.md"
      ]
    },
    "A15": {
      "enabled": false,
      "default_branch": "master",
      "impl_globs": [],
      "test_globs": []
    },
    "A16": {
      "enabled": true
    }
  },
  "baseline": {
    "path": ".seam/baseline.json"
  }
}
